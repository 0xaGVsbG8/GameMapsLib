-- Interactive maps schema (rebuilds maps.json)

CREATE TABLE sites (
  id          TEXT PRIMARY KEY DEFAULT 'default',
  title       TEXT NOT NULL
);

CREATE TABLE games (
  id          TEXT PRIMARY KEY,
  site_id     TEXT NOT NULL DEFAULT 'default' REFERENCES sites(id),
  name        TEXT NOT NULL,
  sort_order  INT NOT NULL DEFAULT 0
);

CREATE TABLE maps (
  id          TEXT PRIMARY KEY,
  game_id     TEXT NOT NULL REFERENCES games(id) ON DELETE CASCADE,
  name        TEXT NOT NULL,
  image       TEXT NOT NULL,
  sort_order  INT NOT NULL DEFAULT 0
);

CREATE TABLE categories (
  id          TEXT NOT NULL,
  map_id      TEXT NOT NULL REFERENCES maps(id) ON DELETE CASCADE,
  name        TEXT NOT NULL,
  sort_order  INT NOT NULL DEFAULT 0,
  PRIMARY KEY (map_id, id)
);

CREATE TABLE items (
  id                  TEXT NOT NULL,
  map_id              TEXT NOT NULL,
  category_id         TEXT NOT NULL,
  name                TEXT NOT NULL,
  icon                TEXT NOT NULL,
  enabled_by_default  BOOLEAN NOT NULL DEFAULT FALSE,
  sort_order          INT NOT NULL DEFAULT 0,
  PRIMARY KEY (map_id, category_id, id),
  FOREIGN KEY (map_id, category_id) REFERENCES categories(map_id, id) ON DELETE CASCADE
);

CREATE TABLE markers (
  id          TEXT NOT NULL,
  map_id      TEXT NOT NULL,
  category_id TEXT NOT NULL,
  item_id     TEXT NOT NULL,
  name        TEXT NOT NULL,
  x           NUMERIC(6,2) NOT NULL,
  y           NUMERIC(6,2) NOT NULL,
  sort_order  INT NOT NULL DEFAULT 0,
  PRIMARY KEY (map_id, category_id, item_id, id),
  FOREIGN KEY (map_id, category_id, item_id)
    REFERENCES items(map_id, category_id, id) ON DELETE CASCADE
);

