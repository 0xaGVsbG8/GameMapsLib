-- Rebuild maps.json
SELECT jsonb_pretty(
  jsonb_build_object(
    'title', s.title,
    'games', (
      SELECT COALESCE(jsonb_agg(game_obj ORDER BY g.sort_order), '[]'::jsonb)
      FROM games g
      CROSS JOIN LATERAL (
        SELECT jsonb_build_object(
          'id', g.id,
          'name', g.name,
          'maps', (
            SELECT COALESCE(jsonb_agg(map_obj ORDER BY m.sort_order), '[]'::jsonb)
            FROM maps m
            CROSS JOIN LATERAL (
              SELECT jsonb_build_object(
                'id', m.id,
                'name', m.name,
                'image', m.image,
                'categories', (
                  SELECT COALESCE(jsonb_agg(cat_obj ORDER BY c.sort_order), '[]'::jsonb)
                  FROM categories c
                  CROSS JOIN LATERAL (
                    SELECT jsonb_build_object(
                      'id', c.id,
                      'name', c.name,
                      'items', (
                        SELECT COALESCE(jsonb_agg(item_obj ORDER BY i.sort_order), '[]'::jsonb)
                        FROM items i
                        CROSS JOIN LATERAL (
                          SELECT jsonb_build_object(
                            'id', i.id,
                            'name', i.name,
                            'icon', i.icon,
                            'enabledByDefault', i.enabled_by_default,
                            'markers', (
                              SELECT COALESCE(jsonb_agg(marker_obj ORDER BY mk.sort_order), '[]'::jsonb)
                              FROM markers mk
                              CROSS JOIN LATERAL (
                                SELECT jsonb_build_object(
                                  'id', mk.id,
                                  'name', mk.name,
                                  'x', mk.x,
                                  'y', mk.y
                                ) AS marker_obj
                              ) marker
                              WHERE mk.map_id = i.map_id
                                AND mk.category_id = i.category_id
                                AND mk.item_id = i.id
                            )
                          ) AS item_obj
                        ) item
                        WHERE i.map_id = c.map_id AND i.category_id = c.id
                      )
                    ) AS cat_obj
                  ) cat
                  WHERE c.map_id = m.id
                )
              ) AS map_obj
            ) map
            WHERE m.game_id = g.id
          )
        ) AS game_obj
      ) game
      WHERE g.site_id = s.id
    )
  )
) AS maps_json
FROM sites s
WHERE s.id = 'default';







