#Paste this file in /etc/systemd/system

[Unit]
Description=Deploy GameMapsLib Docker Compose
After=network.target docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory= #Your path goes here
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
RemainAfterExit=yes
User=root
# ExecStart=/bin/bash -c "source /mylivestocks/virtualpython/venv/bin/activate && /usr/bin/docker compose up -d"

[Install]
WantedBy=multi-user.target
